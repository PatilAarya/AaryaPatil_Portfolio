# Copy to server/.env and fill in.

# MongoDB Atlas (free tier works) or a local instance.
# Leave empty to run without a database (guestbook/letters kept in memory).
MONGODB_URI=

PORT=5000

# Any long random string. Lets you read letters and moderate the guestbook:
#   curl -H "x-admin-token: <token>" http://localhost:5000/api/messages
ADMIN_TOKEN=

# Optional: email each letter to you. Use a Gmail App Password, not your real password
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where letters are sent. Defaults to GMAIL_USER.
MAIL_TO=

# Only needed if the client is hosted on a different domain from the API.
CLIENT_ORIGIN=
