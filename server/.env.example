# Copy to server/.env and fill in.

# MongoDB Atlas (free tier works) or a local instance.
# Leave empty to run without a database (guestbook/letters kept in memory).
MONGODB_URI=

PORT=5000

# Any long random string. Lets you read letters and moderate the guestbook:
#   curl -H "x-admin-token: <token>" http://localhost:5000/api/messages
ADMIN_TOKEN=

# Optional: email each letter to you via Resend (resend.com → API Keys).
RESEND_API_KEY=
# Where letters are sent. Without a verified domain on Resend, this must be
# the same email address your Resend account was created with.
MAIL_TO=
# Optional sender. Leave empty to use Resend's shared address (onboarding@resend.dev);
# set it only after verifying your own domain on Resend.
MAIL_FROM=

# The site(s) allowed to call this API, comma-separated, no trailing slash.
# Required when the frontend is hosted separately (e.g. on Vercel).
CLIENT_ORIGIN=
